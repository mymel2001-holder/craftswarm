# OpenAI-compatible endpoint. Works with OpenAI, Ollama, LM Studio, vLLM, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# One LLM reply per cycle. Long game actions run asynchronously while next cycle waits.
AGENT_MAX_TOOL_ROUNDS=1
AUTONOMOUS_INTERVAL_MS=15000
RECONNECT_MAX_DELAY_MS=30000
